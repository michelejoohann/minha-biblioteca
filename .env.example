# Copy this file to .env.local and replace the placeholders.
# Never commit real credentials or a Supabase service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Public URL used in authentication confirmation links.
# Use http://localhost:3000 locally and your deployed HTTPS URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
